{
  "$schema": "https://opencode.ai/config.schema.json",
  "provider": "deepseek",
  "model": "deepseek-chat",
  "mcpServers": {
    "genehub": {
      "type": "stdio",
      "command": "node",
      "args": ["dist/mcp/index.js"],
      "cwd": "..",
      "env": {
        "DATABASE_URL": "${DATABASE_URL}"
      }
    }
  },
  "systemPrompt": "file://system-prompt.md"
}
